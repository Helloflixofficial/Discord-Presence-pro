{
  "name": "customrp-web",
  "version": "1.0.0",
  "private": true,
  "description": "A local web editor and Discord IPC bridge for CustomRP.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && tsx watch src/server.ts",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "adm-zip": "^0.6.1",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
